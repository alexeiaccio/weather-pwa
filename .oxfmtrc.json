{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "sortTailwindcss": {
    "stylesheet": "./src/index.css"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "public/**",
    ".playwright-mcp/**",
    ".wayfinder/**",
    ".wrangler/**",
    ".vitest-attachments/**",
    "index.html",
    "wrangler.toml",
    "package-lock.json",
    "CONTEXT.md",
    "README.md"
  ]
}
