{
  "name": "weather-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "effect-tsgo patch --oxlint",
    "postinstall": "patch-package",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@effect/platform-browser": "^4.0.0-rc.109",
    "@solidjs/router": "^2.0.0-next.16",
    "@solidjs/web": "^2.0.0-rc.0",
    "atmos-fx": "^0.4.0",
    "effect": "^4.0.0-rc.109",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "solid-js": "^2.0.0-rc.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260812.1",
    "@effect/tsgo": "^0.36.4",
    "@solidjs/testing-library": "^1.0.0-beta.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-solid": "0.14.5",
    "knip": "^6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "patch-package": "^8.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-oxlint": "^2.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-solid": "^3.0.0-next.27",
    "vitest": "4.1.10",
    "wrangler": "^4.122.0"
  }
}
